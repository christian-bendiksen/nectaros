#!/usr/bin/bash
set -euo pipefail

log() {
    echo "[first-login] $*"
}

# Check if services are up and running
wait_for_dbus_service() {
    local service="$1"
    for i in {1..40}; do
        if busctl --user --list | grep -q "$service"; then
            log "DBus service available: $service"
            return 0
        fi
        sleep 0.25
    done
    log "WARNING: Timed out waiting for $service"
    return 1
}

log "Waiting for GNOME session services..."
wait_for_dbus_service org.freedesktop.Notifications || true
wait_for_dbus_service org.gnome.SettingsDaemon      || true

# Set wallpaper
if command -v awww-daemon >/dev/null 2>&1 && command -v awww >/dev/null 2>&1; then
    log "Starting awww-daemon…"
    awww-daemon &

    sleep 0.3

    log "Setting wallpaper with awww…"
    awww img /usr/share/backgrounds/default2.jpg || \
        log "WARNING: awww failed to set wallpaper"
else
    log "awww not found, skipping wallpaper setup"
fi

# GTK flatpak theme override permissions
log "Applying Flatpak theme overrides…"

flatpak override --user --filesystem=xdg-config/gtk-3.0:ro
flatpak override --user --filesystem=xdg-config/gtkrc-2.0:ro
flatpak override --user --filesystem=xdg-config/gtk-4.0:ro
flatpak override --user --filesystem=xdg-config/gtkrc:ro

flatpak mask --user org.gtk.Gtk3theme.adw-gtk3
flatpak mask --user org.gtk.Gtk3theme.adw-gtk3-dark

# GTK Settings
log "Applying GNOME appearance settings…"

if command -v gsettings >/dev/null 2>&1; then
    gsettings set org.gnome.desktop.interface gtk-theme    'adw-gtk3-dark' || true
    gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark' || true
fi

# Finalization
log "Creating first-login completion marker…"

mkdir -p "${HOME}/.config"
touch "${HOME}/.config/.first-login-done"

log "First login setup complete."
