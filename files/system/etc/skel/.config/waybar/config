{
    "layer": "bottom",
    "position": "top",
    "height": 30,
    "spacing": 0,
    "modules-left": ["ext/workspaces","dwl/window"],
    "modules-center": ["custom/clock"],
    "modules-right": ["dwl/language", "pulseaudio", "battery", "backlight", "tray"],

    "ext/workspaces": {
        "disable-scroll": true,
        "format": "{icon}"
    },

    "ext/mode": {
        "format": "  {}"
    },

    "custom/clock": {
        "format": "<span color='#262626'>[ </span>{text}<span color='#262626'> ]</span>",
        "exec": "date +\"%H:%M %A, %b %d\" | awk '{print tolower($0)}'",
        "interval": 3
    },

    "sway/language": {
        "format": "<span color='#262626'>[ </span><span color='#ee5396'><b>key: </b></span>{short}<span color='#262626'> / </span>",
        "tooltip": false
    },

    "pulseaudio": {
        "format": "<span color='#ee5396'><b>vol:</b></span> {volume}%"
    },
    
    "battery": {
        "format": "<span color='#262626'> / </span><span color='#ee5396'><b>bat:</b></span> {capacity}%",
        "format-charging": "<span color='#262626'> / </span><span color='#ee5396'><b>ac:</b></span> {capacity}%",
        "tooltip": false,
        "interval": 20
    },

    "backlight": {
        "format": "<span color='#262626'> / </span><span color='#ee5396'><b>mon:</b></span> {percent}%<span color='#262626'> ]</span>",
        "tooltip": false
    },
    
    "tray": {
        "icon-size": 20,
        "spacing": 7,
        "tooltip": false
    }
}

